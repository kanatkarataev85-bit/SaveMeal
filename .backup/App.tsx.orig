import { useEffect, useMemo, useState } from 'react';
import { Link, Route, Routes, useNavigate, useParams } from 'react-router-dom';

type Role = 'customer' | 'restaurant' | 'organization' | 'administrator';

type User = {
  id: number;
  name: string;
  email: string;
  role: Role;
  approved: boolean;
  organization_name?: string | null;
  city?: string | null;
  phone?: string | null;
};

type Listing = {
  id: number;
  title: string;
  description: string;
  category: string;
  service_type: 'sale' | 'donation';
  price: number;
  original_price: number;
  portions: number;
  available_portions: number;
  allergens: string;
  ingredients: string;
  pickup_window: string;
  storage_instructions: string;
  image_url: string;
  pickup_available: boolean;
  delivery_available: boolean;
  delivery_area: string;
  delivery_fee: number;
  status: string;
  restaurant_name: string;
  actual_restaurant_name: string;
  is_anonymous: boolean;
  notes?: string;
};

type Order = {
  id: number;
  customer_id: number;
  restaurant_id: number;
  listing_id: number;
  quantity: number;
  total_price: number;
  status: string;
  pickup_type: 'pickup' | 'delivery';
  notes?: string;
};

type Complaint = {
  id: number;
  category: string;
  description: string;
  status: string;
};

const formatKgs = (value: number) => `${value.toLocaleString('ru-RU')} с`;

async function apiFetch<T>(path: string, options: RequestInit = {}): Promise<T> {
  const res = await fetch(`/api${path}`, {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      ...(options.headers ?? {}),
    },
    credentials: 'include',
  });

  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    throw new Error(data.message ?? 'Ошибка запроса');
  }
  return data as T;
}

function NavBar({ user, onLogout }: { user: User | null; onLogout: () => Promise<void> }) {
  return (
    <header className="topbar">
      <div className="container nav-inner">
        <Link to="/" className="brand">
          <span className="brand-mark">S</span>
          SaveMeal
        </Link>
        <nav className="nav-links">
          <Link to="/">Главная</Link>
          <Link to="/catalog">Каталог</Link>
          <Link to="/donations">Пожертвования</Link>
          {user ? <Link to="/dashboard">Личный кабинет</Link> : <Link to="/login">Войти</Link>}
        </nav>
        {user ? (
          <div className="user-pill-row">
            <span className="user-pill">{user.name}</span>
            <button className="secondary-button" onClick={() => onLogout()}>Выйти</button>
          </div>
        ) : (
          <Link className="primary-button" to="/login">Присоединиться</Link>
        )}
      </div>
    </header>
  );
}

