import express from 'express';
import cors from 'cors';
import cookieParser from 'cookie-parser';
import dotenv from 'dotenv';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import Database from 'better-sqlite3';
import path from 'node:path';
import fs from 'node:fs';
import { z } from 'zod';

dotenv.config();

const app = express();
const port = Number(process.env.PORT ?? 4000);
const jwtSecret = process.env.JWT_SECRET ?? 'change-me-in-production';
const dataDir = path.join(process.cwd(), 'data');
const dbPath = path.join(dataDir, 'savemeal.db');
fs.mkdirSync(dataDir, { recursive: true });
const db = new Database(dbPath);
db.pragma('journal_mode = WAL');

type Role = 'customer' | 'restaurant' | 'organization' | 'administrator';

type UserRecord = {
  id: number;
  name: string;
  email: string;
  password_hash: string;
  role: Role;
  approved: number;
  is_active: number;
  phone: string;
  avatar_url: string | null;
  organization_name: string | null;
  city: string | null;
  created_at: string;
};

type ListingRecord = {
  id: number;
  restaurant_id: number;
  title: string;
  description: string;
  category: string;
  service_type: 'sale' | 'donation';
  price: number;
  original_price: number;
  portions: number;
  available_portions: number;
  allergens: string | null;
  ingredients: string | null;
  pickup_window: string | null;
  storage_instructions: string | null;
  image_url: string | null;
  pickup_available: number;
  delivery_available: number;
  delivery_area: string | null;
  delivery_fee: number;
  is_anonymous: number;
  status: string;
  created_at: string;
  updated_at: string;
  notes: string | null;
};

type SafeUser = Omit<UserRecord, 'password_hash'>;

const userSchema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
  password: z.string().min(6),
  role: z.enum(['customer', 'restaurant', 'organization']),
});

const listingSchema = z.object({
  title: z.string().min(3),
  description: z.string().min(10),
  category: z.string().min(2),
  serviceType: z.enum(['sale', 'donation']),
  price: z.coerce.number().min(0),
  originalPrice: z.coerce.number().min(0),
  portions: z.coerce.number().int().min(1),
  allergens: z.string().optional().default(''),
  ingredients: z.string().optional().default(''),
  pickupWindow: z.string().min(3, 'Укажите окно выдачи.'),
  bestBefore: z.string().optional().default(''),
  storageInstructions: z.string().optional().default(''),
  imageUrl: z.string().url('Нужна корректная ссылка на фото.').optional().default('https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=1200&q=80'),
  isAnonymous: z.coerce.boolean().optional().default(false),
  pickupAvailable: z.coerce.boolean().optional().default(true),
  deliveryAvailable: z.coerce.boolean().optional().default(false),
  deliveryArea: z.string().optional().default(''),
  deliveryFee: z.coerce.number().min(0).optional().default(0),
  notes: z.string().optional().default(''),
}).refine((data) => data.pickupAvailable || data.deliveryAvailable, {
  message: 'Нужен хотя бы один способ получения: самовывоз или доставка.',
  path: ['pickupAvailable'],
}).refine((data) => data.serviceType === 'donation' || data.originalPrice >= data.price, {
  message: 'Цена не может быть выше исходной цены.',
  path: ['originalPrice'],
});

const orderSchema = z.object({
  listingId: z.coerce.number().int().positive(),
  quantity: z.coerce.number().int().positive(),
  pickupType: z.enum(['pickup', 'delivery']),
  deliveryAddress: z.string().optional().default(''),
  notes: z.string().optional().default(''),
});

const complaintSchema = z.object({
  orderId: z.coerce.number().int().positive().optional(),
  listingId: z.coerce.number().int().positive().optional(),
  category: z.enum(['quality', 'delivery', 'safety', 'other']),
  description: z.string().min(10),
  photoUrl: z.string().optional().default(''),
}).refine((data) => data.orderId || data.listingId, {
  message: 'Укажите заказ или объявление.',
  path: ['orderId'],
}).refine((data) => !(data.orderId && data.listingId), {
  message: 'Укажите либо заказ, либо объявление.',
  path: ['listingId'],
});

function createAuthToken(user: SafeUser) {
  return jwt.sign({ id: user.id, role: user.role, email: user.email }, jwtSecret, { expiresIn: '7d' });
}

function getUserFromRequest(req: express.Request) {
  const token = req.cookies?.token || req.headers.authorization?.replace('Bearer ', '');
  if (!token) return null;
  try {
    const payload = jwt.verify(token, jwtSecret) as { id: number; role: string; email: string };
    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(payload.id) as UserRecord | undefined;
    if (!user) return null;
    return user as UserRecord;
  } catch {
    return null;
  }
}

function authRequired(req: express.Request, res: express.Response, next: express.NextFunction) {
  const user = getUserFromRequest(req);
  if (!user) {
    res.status(401).json({ message: 'Необходима авторизация.' });
    return;
  }
  (req as express.Request & { user: UserRecord }).user = user;
  next();
}

function requireRole(roles: string[]) {
  return (req: express.Request, res: express.Response, next: express.NextFunction) => {
    const user = (req as express.Request & { user?: UserRecord }).user;
    if (!user || !roles.includes(user.role)) {
      res.status(403).json({ message: 'Нет доступа к этой функции.' });
      return;
    }
    next();
  };
}

function serializeUser(user: UserRecord | undefined) {
  if (!user) return null;
  const { password_hash, ...safe } = user;
  return safe as SafeUser;
}

function initDatabase() {
  db.exec(`
    CREATE TABLE IF NOT EXISTS users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      email TEXT NOT NULL UNIQUE,
      password_hash TEXT NOT NULL,
      role TEXT NOT NULL CHECK(role IN ('customer', 'restaurant', 'organization', 'administrator')),
      approved INTEGER DEFAULT 0,
      is_active INTEGER DEFAULT 1,
      phone TEXT,
      avatar_url TEXT,
      organization_name TEXT,
      city TEXT,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    );

    CREATE TABLE IF NOT EXISTS listings (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      restaurant_id INTEGER NOT NULL,
      title TEXT NOT NULL,
      description TEXT NOT NULL,
      category TEXT NOT NULL,
      service_type TEXT NOT NULL CHECK(service_type IN ('sale', 'donation')),
      price INTEGER NOT NULL DEFAULT 0,
      original_price INTEGER NOT NULL DEFAULT 0,
      portions INTEGER NOT NULL DEFAULT 0,
      available_portions INTEGER NOT NULL DEFAULT 0,
      allergens TEXT,
      ingredients TEXT,
      pickup_window TEXT,
      storage_instructions TEXT,
      image_url TEXT,
      pickup_available INTEGER DEFAULT 1,
      delivery_available INTEGER DEFAULT 0,
      delivery_area TEXT,
      delivery_fee INTEGER DEFAULT 0,
      is_anonymous INTEGER DEFAULT 0,
      status TEXT NOT NULL DEFAULT 'draft' CHECK(status IN ('draft','pending_review','published','sold_out','expired','suspended')),
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      notes TEXT,
      FOREIGN KEY (restaurant_id) REFERENCES users(id)
    );

    CREATE TABLE IF NOT EXISTS orders (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      customer_id INTEGER NOT NULL,
      restaurant_id INTEGER NOT NULL,
      listing_id INTEGER NOT NULL,
      quantity INTEGER NOT NULL,
      total_price INTEGER NOT NULL,
      status TEXT NOT NULL CHECK(status IN ('pending_confirmation','confirmed','preparing','ready','completed','cancelled','refunded')),
      pickup_type TEXT NOT NULL CHECK(pickup_type IN ('pickup', 'delivery')),
      delivery_address TEXT,
      notes TEXT,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (customer_id) REFERENCES users(id),
      FOREIGN KEY (restaurant_id) REFERENCES users(id),
      FOREIGN KEY (listing_id) REFERENCES listings(id)
    );

    CREATE TABLE IF NOT EXISTS donation_requests (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      organization_id INTEGER NOT NULL,
      listing_id INTEGER NOT NULL,
      notes TEXT,
      status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending','approved','rejected','collected','completed')),
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (organization_id) REFERENCES users(id),
      FOREIGN KEY (listing_id) REFERENCES listings(id)
    );

    CREATE TABLE IF NOT EXISTS complaints (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      order_id INTEGER NOT NULL,
      user_id INTEGER NOT NULL,
      category TEXT NOT NULL,
      description TEXT NOT NULL,
      photo_url TEXT,
      status TEXT NOT NULL DEFAULT 'new' CHECK(status IN ('new','reviewing','resolved','dismissed')),
      admin_note TEXT,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (order_id) REFERENCES orders(id),
      FOREIGN KEY (user_id) REFERENCES users(id)
    );

    CREATE TABLE IF NOT EXISTS audit_logs (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      actor_id INTEGER,
      action TEXT NOT NULL,
      details TEXT,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (actor_id) REFERENCES users(id)
    );
  `);

  const adminExists = db.prepare('SELECT id FROM users WHERE role = ?').get('administrator');
  if (!adminExists) {
    const passwordHash = bcrypt.hashSync('Admin123!', 10);
    db.prepare(`
      INSERT INTO users (name, email, password_hash, role, approved, is_active, city, phone, organization_name)
      VALUES (?, ?, ?, 'administrator', 1, 1, 'Бишкек', '+996500000000', 'SaveMeal Team')
    `).run('Администратор SaveMeal', 'admin@savemeal.kg', passwordHash);
  }
}

function ensureColumn(table: string, definition: string) {
  const name = definition.split(' ')[0];
  const cols = db.prepare(`PRAGMA table_info(${table})`).all() as { name: string; notnull: number }[];
  if (!cols.some((c) => c.name === name)) {
    db.exec(`ALTER TABLE ${table} ADD COLUMN ${definition}`);
  }
}

function migrateComplaints() {
  const cols = db.prepare('PRAGMA table_info(complaints)').all() as { name: string; notnull: number }[];
  const orderIdCol = cols.find((c) => c.name === 'order_id');
  if (orderIdCol && orderIdCol.notnull === 1) {
    db.transaction(() => {
      db.exec(`
        CREATE TABLE complaints_new (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          order_id INTEGER,
          listing_id INTEGER,
          user_id INTEGER NOT NULL,
          category TEXT NOT NULL,
          description TEXT NOT NULL,
          photo_url TEXT,
          status TEXT NOT NULL DEFAULT 'new' CHECK(status IN ('new','reviewing','resolved','dismissed')),
          admin_note TEXT,
          created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
          FOREIGN KEY (order_id) REFERENCES orders(id),
          FOREIGN KEY (user_id) REFERENCES users(id)
        )
      `);
      db.exec(`
        INSERT INTO complaints_new (id, order_id, listing_id, user_id, category, description, photo_url, status, admin_note, created_at)
        SELECT id, order_id, NULL, user_id, category, description, photo_url, status, admin_note, created_at FROM complaints
      `);
      db.exec('DROP TABLE complaints');
      db.exec('ALTER TABLE complaints_new RENAME TO complaints');
    })();
  }
}

function ensureSchema() {
  ensureColumn('listings', 'best_before TEXT');
  ensureColumn('listings', 'rejection_reason TEXT');
  ensureColumn('donation_requests', 'portions INTEGER NOT NULL DEFAULT 1');
  migrateComplaints();
}

function seedDemoData() {
  const restaurantCount = db.prepare('SELECT COUNT(*) as count FROM users WHERE role = ?').get('restaurant') as { count: number };
  if (restaurantCount.count > 0) return;

  const customerHash = bcrypt.hashSync('Customer123!', 10);
  const restaurantHash = bcrypt.hashSync('Restaurant123!', 10);
  const orgHash = bcrypt.hashSync('Org123456!', 10);

  db.transaction(() => {
    const customerId = db.prepare(`
      INSERT INTO users (name, email, password_hash, role, approved, is_active, city, phone)
      VALUES (?, ?, ?, 'customer', 1, 1, 'Бишкек', '+996700111222')
    `).run('Айдана К.', 'customer@savemeal.kg', customerHash).lastInsertRowid as number;

    const restaurantId = db.prepare(`
      INSERT INTO users (name, email, password_hash, role, approved, is_active, city, phone, organization_name)
      VALUES (?, ?, ?, 'restaurant', 1, 1, 'Бишкек', '+996700222333', 'Кафе “Кызыл Бешек”')
    `).run('Кафе “Кызыл Бешек”', 'restaurant@savemeal.kg', restaurantHash).lastInsertRowid as number;

    const organizationId = db.prepare(`
      INSERT INTO users (name, email, password_hash, role, approved, is_active, city, phone, organization_name)
      VALUES (?, ?, ?, 'organization', 1, 1, 'Бишкек', '+996700333444', 'Приют “Надежда”')
    `).run('Приют “Надежда”', 'org@savemeal.kg', orgHash).lastInsertRowid as number;

    db.prepare(`
      INSERT INTO listings (restaurant_id, title, description, category, service_type, price, original_price, portions, available_portions, allergens, ingredients, pickup_window, storage_instructions, image_url, pickup_available, delivery_available, delivery_area, delivery_fee, is_anonymous, status, notes)
      VALUES (?, ?, ?, ?, 'sale', 210, 420, 12, 12, 'Глютен, молоко', 'Лаваш, курица, овощи, соус', 'Сегодня до 20:00', 'Хранить в холодильнике до 2 часов', 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=1200&q=80', 1, 1, 'ЦУМ, Парк Горького', 80, 1, 'published', 'Готово к выдаче после подтверждения.')
    `).run(restaurantId, 'Ланч-бокс с курицей', 'Безопасная порция из свежего лаваша и овощей по сниженной цене.', 'Основные блюда');

    db.prepare(`
      INSERT INTO listings (restaurant_id, title, description, category, service_type, price, original_price, portions, available_portions, allergens, ingredients, pickup_window, storage_instructions, image_url, pickup_available, delivery_available, delivery_area, delivery_fee, is_anonymous, status, notes)
      VALUES (?, ?, ?, ?, 'donation', 0, 500, 20, 20, 'Молоко', 'Овсяная каша, яблоко, корица', 'Сегодня до 18:00', 'Охлаждать до передачи', 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80', 1, 0, '', 0, 0, 'published', 'Подходит для нуждающихся семей и организаций.')
    `).run(restaurantId, 'Завтрак для социальных учреждений', 'Подходит для передачи в приюты и благотворительные организации.', 'Завтраки');

    const saleListing = db.prepare('SELECT id FROM listings WHERE title = ?').get('Ланч-бокс с курицей') as { id: number };
    const donationListing = db.prepare('SELECT id FROM listings WHERE title = ?').get('Завтрак для социальных учреждений') as { id: number };

    const orderInsert = db.prepare(`
      INSERT INTO orders (customer_id, restaurant_id, listing_id, quantity, total_price, status, pickup_type, delivery_address, notes)
      VALUES (?, ?, ?, 2, 420, 'ready', 'pickup', '', 'К заказу можно приехать после 18:30.')
    `).run(customerId, restaurantId, saleListing.id);

    db.prepare(`
      INSERT INTO donation_requests (organization_id, listing_id, notes, status)
      VALUES (?, ?, 'Нужна помощь для завтрака детей.', 'pending')
    `).run(organizationId, donationListing.id);

    db.prepare(`
      INSERT INTO complaints (order_id, user_id, category, description, status)
      VALUES (?, ?, 'quality', 'В заказе было меньше салата, чем ожидалось.', 'new')
    `).run(orderInsert.lastInsertRowid as number, customerId);
  })();
}

function buildPublicListing(listing: ListingRecord, viewer?: { id: number; role: Role }) {
  const restaurant = db.prepare('SELECT * FROM users WHERE id = ?').get(listing.restaurant_id) as UserRecord;
  const realName = restaurant.organization_name || restaurant.name;
  const isOwner = viewer && viewer.id === listing.restaurant_id;
  const canSeeIdentity = !listing.is_anonymous || isOwner || viewer?.role === 'administrator';
  const publicName = canSeeIdentity ? realName : 'Анонимный партнер';

  return {
    ...listing,
    restaurant_name: publicName,
    available_portions: Number(listing.available_portions),
    price: Number(listing.price),
    original_price: Number(listing.original_price),
    delivery_fee: Number(listing.delivery_fee),
    is_anonymous: Boolean(listing.is_anonymous),
    pickup_available: Boolean(listing.pickup_available),
    delivery_available: Boolean(listing.delivery_available),
  };
}

function convertToUserToken(user: UserRecord) {
  return {
    id: user.id,
    name: user.name,
    email: user.email,
    role: user.role,
    approved: Boolean(user.approved),
    organization_name: user.organization_name,
    city: user.city,
    phone: user.phone,
  };
}

async function registerUser(payload: z.infer<typeof userSchema>) {
  const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(payload.email);
  if (existing) {
    throw new Error('Пользователь с таким email уже существует.');
  }

  const passwordHash = await bcrypt.hash(payload.password, 10);
  const approved = payload.role === 'customer' ? 1 : 0;
  const user = db.prepare(`
    INSERT INTO users (name, email, password_hash, role, approved, is_active, city, phone, organization_name)
    VALUES (?, ?, ?, ?, ?, 1, 'Бишкек', '', '')
  `).run(payload.name, payload.email, passwordHash, payload.role, approved);

  return db.prepare('SELECT * FROM users WHERE id = ?').get(user.lastInsertRowid) as UserRecord;
}

function getListingsForUser(viewer: { id: number; role: Role } | null, query: Record<string, unknown>) {
  const where: string[] = [];
  const params: unknown[] = [];

  if (!viewer || viewer.role === 'customer' || viewer.role === 'organization') {
    where.push("l.status = 'published'");
  } else if (viewer.role === 'restaurant') {
    where.push('(l.status = \'published\' OR l.restaurant_id = ?)');
    params.push(viewer.id);
  }

  const category = typeof query.category === 'string' ? query.category.trim() : '';
  if (category && category !== 'all') {
    where.push('l.category = ?');
    params.push(category);
  }

  const serviceType = typeof query.serviceType === 'string' ? query.serviceType.trim() : '';
  if (serviceType === 'sale' || serviceType === 'donation') {
    where.push('l.service_type = ?');
    params.push(serviceType);
  }

  const search = typeof query.q === 'string' ? query.q.trim().toLowerCase() : '';
  if (search) {
    where.push("(lower(l.title) LIKE ? OR lower(l.description) LIKE ?)");
    params.push(`%${search}%`, `%${search}%`);
  }

  const maxPrice = Number(query.maxPrice);
  if (Number.isFinite(maxPrice) && maxPrice >= 0) {
    where.push('l.price <= ?');
    params.push(maxPrice);
  }

  const minPrice = Number(query.minPrice);
  if (Number.isFinite(minPrice) && minPrice >= 0) {
    where.push('l.price >= ?');
    params.push(minPrice);
  }

  if (query.available === 'true' || query.available === '1') {
    where.push('l.available_portions > 0');
  }

  if (query.pickupOnly === 'true') {
    where.push('l.pickup_available = 1');
  }

  if (query.deliveryOnly === 'true') {
    where.push('l.delivery_available = 1');
  }

  const sortKey = typeof query.sort === 'string' ? query.sort : 'new';
  const orderBy =
    sortKey === 'price_asc' ? 'l.price ASC'
    : sortKey === 'price_desc' ? 'l.price DESC'
    : sortKey === 'discount' ? 'CASE WHEN l.original_price > l.price THEN (l.original_price - l.price) * 1.0 / l.original_price ELSE 0 END DESC'
    : 'l.created_at DESC';

  const sql = `SELECT l.* FROM listings l ${where.length ? `WHERE ${where.join(' AND ')}` : ''} ORDER BY ${orderBy}`;
  const rows = db.prepare(sql).all(...params) as ListingRecord[];

  const allCategories = (db.prepare("SELECT DISTINCT category FROM listings WHERE status = 'published' ORDER BY category").all() as { category: string }[])
    .map((row) => row.category);
  const priceBounds = db.prepare("SELECT MIN(price) as minPrice, MAX(price) as maxPrice FROM listings WHERE status = 'published'").get() as { minPrice: number | null; maxPrice: number | null };

  return {
    items: rows.map((row) => buildPublicListing(row, viewer ?? undefined)),
    meta: {
      total: rows.length,
      categories: allCategories,
      minPrice: Number(priceBounds.minPrice ?? 0),
      maxPrice: Number(priceBounds.maxPrice ?? 0),
    },
  };
}

function ensureListingQuantity(listing: ListingRecord, quantity: number) {
  if (listing.service_type === 'donation') {
    return quantity > 0 && quantity <= (listing.available_portions ?? 0);
  }
  return quantity > 0 && quantity <= (listing.available_portions ?? 0) && listing.status === 'published';
}

app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '2mb' }));
app.use(cookieParser());

app.get('/api/health', (_req, res) => {
  res.json({ ok: true, service: 'SaveMeal API' });
});

app.post('/api/auth/register', async (req, res) => {
  try {
    const parsed = userSchema.parse(req.body);
    const user = await registerUser(parsed);
    const token = createAuthToken(serializeUser(user) as SafeUser);
    res.cookie('token', token, { httpOnly: true, sameSite: 'lax', secure: false });
    res.status(201).json({ user: convertToUserToken(user), token });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка регистрации.';
    res.status(400).json({ message });
  }
});

app.post('/api/auth/login', async (req, res) => {
  const { email, password } = req.body as { email?: string; password?: string };
  if (!email || !password) {
    res.status(400).json({ message: 'Нужно указать email и пароль.' });
    return;
  }

  const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRecord | undefined;
  if (!user || !await bcrypt.compare(password, user.password_hash)) {
    res.status(401).json({ message: 'Неверный email или пароль.' });
    return;
  }

  const token = createAuthToken(serializeUser(user) as SafeUser);
  res.cookie('token', token, { httpOnly: true, sameSite: 'lax', secure: false });
  res.json({ user: convertToUserToken(user), token });
});

app.post('/api/auth/logout', (_req, res) => {
  res.clearCookie('token');
  res.json({ ok: true });
});

app.get('/api/auth/me', (req, res) => {
  const user = getUserFromRequest(req);
  if (!user) {
    res.status(401).json({ message: 'Пользователь не авторизован.' });
    return;
  }
  res.json({ user: convertToUserToken(user) });
});

app.get('/api/listings', (req, res) => {
  const user = getUserFromRequest(req);
  const result = getListingsForUser(user, req.query as Record<string, unknown>);
  res.json(result);
});

app.get('/api/listings/:id', (req, res) => {
  const listing = db.prepare('SELECT * FROM listings WHERE id = ?').get(Number(req.params.id)) as any;
  if (!listing) {
    res.status(404).json({ message: 'Листинг не найден.' });
    return;
  }
  const user = getUserFromRequest(req);
  res.json({ item: buildPublicListing(listing, user ?? undefined) });
});

app.post('/api/listings', authRequired, requireRole(['restaurant']), (req, res) => {
  try {
    const parsed = listingSchema.parse(req.body);
    const user = (req as express.Request & { user: UserRecord }).user;
    if (!user.approved) {
      res.status(403).json({ message: 'Ресторан должен пройти модерацию перед публикацией.' });
      return;
    }

    const result = db.prepare(`
      INSERT INTO listings (
        restaurant_id, title, description, category, service_type, price, original_price,
        portions, available_portions, allergens, ingredients, pickup_window, best_before, storage_instructions,
        image_url, pickup_available, delivery_available, delivery_area, delivery_fee,
        is_anonymous, status, notes, created_at, updated_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending_review', ?, datetime('now'), datetime('now'))
    `).run(
      user.id,
      parsed.title,
      parsed.description,
      parsed.category,
      parsed.serviceType,
      parsed.price,
      parsed.originalPrice,
      parsed.portions,
      parsed.portions,
      parsed.allergens,
      parsed.ingredients,
      parsed.pickupWindow,
      parsed.bestBefore,
      parsed.storageInstructions,
      parsed.imageUrl,
      Number(parsed.pickupAvailable),
      Number(parsed.deliveryAvailable),
      parsed.deliveryArea,
      parsed.deliveryFee,
      Number(parsed.isAnonymous),
      parsed.notes,
    );

    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(
      user.id,
      'listing_created',
      JSON.stringify({ listingId: result.lastInsertRowid, serviceType: parsed.serviceType }),
    );

    const created = db.prepare('SELECT * FROM listings WHERE id = ?').get(result.lastInsertRowid) as any;
    res.status(201).json({ item: buildPublicListing(created, user) });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка создания листинга.';
    res.status(400).json({ message });
  }
});

app.post('/api/orders', authRequired, requireRole(['customer']), (req, res) => {
  try {
    const parsed = orderSchema.parse(req.body);
    const user = (req as express.Request & { user: UserRecord }).user;
    const listing = db.prepare('SELECT * FROM listings WHERE id = ?').get(parsed.listingId) as any;

    if (!listing) {
      res.status(404).json({ message: 'Листинг не найден.' });
      return;
    }

    if (listing.status !== 'published') {
      res.status(400).json({ message: 'Листинг недоступен для заказа.' });
      return;
    }

    if (listing.service_type === 'donation') {
      res.status(400).json({ message: 'Бесплатные наборы передаются через запросы организаций.' });
      return;
    }

    if (!ensureListingQuantity(listing, parsed.quantity)) {
      res.status(400).json({ message: 'Недостаточно доступных порций.' });
      return;
    }

    if (parsed.pickupType === 'delivery') {
      if (!listing.delivery_available) {
        res.status(400).json({ message: 'Доставка для этого предложения недоступна.' });
        return;
      }
      if (!parsed.deliveryAddress || parsed.deliveryAddress.trim().length < 5) {
        res.status(400).json({ message: 'Укажите корректный адрес доставки.' });
        return;
      }
    }

    const subtotal = listing.price * parsed.quantity;
    const deliveryFee = parsed.pickupType === 'delivery' && listing.delivery_available ? listing.delivery_fee : 0;
    const total = subtotal + deliveryFee;

    const row = db.prepare('SELECT * FROM orders WHERE listing_id = ? AND quantity = ? AND total_price = ?').get(listing.id, parsed.quantity, total);
    if (row) {
      res.status(409).json({ message: 'Вы уже создали такой заказ.' });
      return;
    }

    const updateRes = db.prepare('UPDATE listings SET available_portions = available_portions - ?, updated_at = datetime("now") WHERE id = ? AND available_portions >= ?').run(parsed.quantity, listing.id, parsed.quantity);
    if (updateRes.changes === 0) {
      res.status(400).json({ message: 'Недостаточно доступных порций.' });
      return;
    }

    const orderResult = db.prepare(`
      INSERT INTO orders (customer_id, restaurant_id, listing_id, quantity, total_price, status, pickup_type, delivery_address, notes, created_at, updated_at)
      VALUES (?, ?, ?, ?, ?, 'pending_confirmation', ?, ?, ?, datetime('now'), datetime('now'))
    `).run(user.id, listing.restaurant_id, listing.id, parsed.quantity, total, parsed.pickupType, parsed.deliveryAddress || '', parsed.notes || '');

    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(
      user.id, 'order_created', JSON.stringify({ orderId: orderResult.lastInsertRowid, listingId: listing.id, total }),
    );

    const order = db.prepare('SELECT * FROM orders WHERE id = ?').get(orderResult.lastInsertRowid) as any;
    res.status(201).json({ order, message: 'Заказ создан и ожидает подтверждения ресторана.', breakdown: { subtotal, deliveryFee, total } });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка создания заказа.';
    res.status(400).json({ message });
  }
});

app.get('/api/orders/my', authRequired, (req, res) => {
  const user = (req as express.Request & { user: UserRecord }).user;
  const rows =
    user.role === 'restaurant'
      ? db.prepare('SELECT o.*, l.title as listing_title FROM orders o LEFT JOIN listings l ON o.listing_id = l.id WHERE o.restaurant_id = ? ORDER BY o.created_at DESC').all(user.id)
      : db.prepare('SELECT o.*, l.title as listing_title FROM orders o LEFT JOIN listings l ON o.listing_id = l.id WHERE o.customer_id = ? ORDER BY o.created_at DESC').all(user.id);
  res.json({ items: rows });
});

const allowedTransitions: Record<string, string[]> = {
  pending_confirmation: ['confirmed', 'cancelled'],
  confirmed: ['preparing', 'cancelled'],
  preparing: ['ready', 'cancelled'],
  ready: ['completed', 'cancelled'],
  cancelled: [],
  refunded: [],
  completed: ['refunded'],
};

app.patch('/api/orders/:id/status', authRequired, (req, res) => {
  const user = (req as express.Request & { user: UserRecord }).user;
  const orderId = Number(req.params.id);
  const status = String(req.body?.status || '');
  const allowed = allowedTransitions[status] || [];

  const order = db.prepare('SELECT * FROM orders WHERE id = ?').get(orderId) as any;
  if (!order) {
    res.status(404).json({ message: 'Заказ не найден.' });
    return;
  }

  if (!allowed.includes(order.status)) {
    res.status(400).json({ message: `Из текущего статуса "${order.status}" нельзя перейти в "${status}".` });
    return;
  }

  const isRestaurantOwner = user.role === 'restaurant' && order.restaurant_id === user.id;
  const isCustomerOwner = user.role === 'customer' && order.customer_id === user.id;
  const isAdmin = user.role === 'administrator';

  const isAllowedStatus = status === 'cancelled' || status === 'refunded';
  if (status !== 'cancelled' && !isRestaurantOwner && !isAdmin) {
    res.status(403).json({ message: 'Вы не можете менять статус этого заказа.' });
    return;
  }

  if (isAllowedStatus && !isCustomerOwner && !isAdmin) {
    res.status(403).json({ message: 'Только покупатель может отменить заказ.' });
    return;
  }

  if (!isRestaurantOwner && !isAdmin && status !== 'cancelled') {
    res.status(403).json({ message: 'Вы не можете менять статус этого заказа.' });
    return;
  }

  const reason = req.body?.reason || '';
  db.prepare('UPDATE orders SET status = ?, updated_at = datetime("now") WHERE id = ?').run(status, orderId);

  if (status === 'cancelled' || status === 'refunded') {
    db.prepare('UPDATE listings SET available_portions = available_portions + ?, updated_at = datetime("now") WHERE id = ? AND available_portions >= -?').run(order.quantity, order.listing_id, order.quantity);
    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(user.id, `order_${status}`, JSON.stringify({ orderId, reason }));
  } else {
    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(user.id, 'order_status_change', JSON.stringify({ orderId, status }));
  }

  res.json({ ok: true, status });
});

app.get('/api/donations', (req, res) => {
  const user = getUserFromRequest(req);
  const rows = db.prepare('SELECT * FROM listings WHERE service_type = ? AND status = ? ORDER BY created_at DESC').all('donation', 'published') as ListingRecord[];
  res.json({ items: rows.map((row: ListingRecord) => buildPublicListing(row, user ?? undefined)) });
});

const donationRequestSchema = z.object({
  listingId: z.coerce.number().int().positive(),
  portions: z.coerce.number().int().min(1).optional().default(1),
  notes: z.string().optional().default(''),
});

const donationStatusSchema = z.object({
  status: z.enum(['approved', 'rejected', 'collected', 'completed']),
});

app.post('/api/donations/request', authRequired, requireRole(['organization']), (req, res) => {
  try {
    const parsed = donationRequestSchema.parse(req.body);
    const user = (req as express.Request & { user: UserRecord }).user;
    const listing = db.prepare('SELECT * FROM listings WHERE id = ?').get(parsed.listingId) as any;
    if (!listing || listing.service_type !== 'donation') {
      res.status(404).json({ message: 'Подарок не найден.' });
      return;
    }
    if (!user.approved) {
      res.status(403).json({ message: 'Организация должна пройти проверку перед оформлением запроса.' });
      return;
    }

    const existing = db.prepare('SELECT * FROM donation_requests WHERE organization_id = ? AND listing_id = ? AND status IN (\'pending\', \'approved\')').get(user.id, listing.id);
    if (existing) {
      res.status(400).json({ message: 'Запрос уже отправлен ранее.' });
      return;
    }

    const result = db.prepare(`
      INSERT INTO donation_requests (organization_id, listing_id, portions, notes, status, created_at)
      VALUES (?, ?, ?, ?, 'pending', datetime('now'))
    `).run(user.id, listing.id, parsed.portions, parsed.notes || '');

    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(
      user.id, 'donation_request_created', JSON.stringify({ requestId: result.lastInsertRowid, listingId: listing.id, portions: parsed.portions }),
    );

    res.status(201).json({ id: result.lastInsertRowid, message: 'Запрос на передачу отправлен.' });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка запроса на помощь.';
    res.status(400).json({ message });
  }
});

app.get('/api/donations/requests/my', authRequired, requireRole(['organization']), (req, res) => {
  const user = (req as express.Request & { user: UserRecord }).user;
  const rows = db.prepare(`
    SELECT dr.*, l.title as listing_title, l.restaurant_id
    FROM donation_requests dr
    LEFT JOIN listings l ON dr.listing_id = l.id
    WHERE dr.organization_id = ?
    ORDER BY dr.created_at DESC
  `).all(user.id) as any[];
  res.json({ items: rows });
});

app.get('/api/donations/requests/received', authRequired, requireRole(['restaurant']), (req, res) => {
  const user = (req as express.Request & { user: UserRecord }).user;
  const rows = db.prepare(`
    SELECT dr.*, l.title as listing_title, u.name as org_name
    FROM donation_requests dr
    LEFT JOIN listings l ON dr.listing_id = l.id
    LEFT JOIN users u ON dr.organization_id = u.id
    WHERE l.restaurant_id = ?
    ORDER BY dr.created_at DESC
  `).all(user.id) as any[];
  res.json({ items: rows });
});

app.post('/api/donations/requests/:id/status', authRequired, (req, res) => {
  try {
    const user = (req as express.Request & { user: UserRecord }).user;
    const requestId = Number(req.params.id);
    const { status, reason } = z.object({ status: z.enum(['approved', 'rejected', 'collected', 'completed']) }).parse(req.body);

    const request = db.prepare('SELECT * FROM donation_requests WHERE id = ?').get(requestId) as any;
    if (!request) {
      res.status(404).json({ message: 'Запрос не найден.' });
      return;
    }

    const listing = db.prepare('SELECT * FROM listings WHERE id = ?').get(request.listing_id) as any;
    if (!listing) {
      res.status(404).json({ message: 'Связанный листинг не найден.' });
      return;
    }

    const isRestaurantOwner = user.role === 'restaurant' && listing.restaurant_id === user.id;
    const isAdmin = user.role === 'administrator';
    const isOrg = user.role === 'organization' && request.organization_id === user.id;
    if (!isRestaurantOwner && !isAdmin && !isOrg) {
      res.status(403).json({ message: 'Вы не можете управлять этим запросом.' });
      return;
    }

    if (request.status === 'pending' && (status === 'approved' || status === 'rejected')) {
      db.prepare('UPDATE donation_requests SET status = ?, notes = COALESCE(notes, "") || CASE WHEN ? != "" THEN "\nПричина: " || ? ELSE "" END, created_at = created_at WHERE id = ?').run(status, reason || '', reason || '', requestId);
      if (status === 'approved') {
        db.prepare('UPDATE listings SET available_portions = MAX(0, available_portions - ?), updated_at = datetime("now") WHERE id = ?').run(request.portions, listing.id);
      }
      db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(user.id, 'donation_request_status', JSON.stringify({ requestId, status, reason }));
      res.json({ ok: true, status });
      return;
    }

    if (request.status === 'approved' && status === 'rejected') {
      db.prepare('UPDATE donation_requests SET status = ?, notes = COALESCE(notes, "") || CASE WHEN ? != "" THEN "\nПричина: " || ? ELSE "" END, created_at = created_at WHERE id = ?').run(status, reason || '', reason || '', requestId);
      db.prepare('UPDATE listings SET available_portions = available_portions + ?, updated_at = datetime("now") WHERE id = ?').run(request.portions, listing.id);
      db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(user.id, 'donation_request_rejected_after_approve', JSON.stringify({ requestId, reason }));
      res.json({ ok: true, status });
      return;
    }

    if (request.status === 'approved' && status === 'collected') {
      db.prepare('UPDATE donation_requests SET status = ? WHERE id = ?').run(status, requestId);
      db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(user.id, 'donation_collected', JSON.stringify({ requestId }));
      res.json({ ok: true, status });
      return;
    }

    if (request.status === 'collected' && status === 'completed') {
      db.prepare('UPDATE donation_requests SET status = ? WHERE id = ?').run(status, requestId);
      db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(user.id, 'donation_completed', JSON.stringify({ requestId }));
      res.json({ ok: true, status });
      return;
    }

    res.status(400).json({ message: `Нельзя перейти из "${request.status}" в "${status}".` });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка изменения статуса.';
    res.status(400).json({ message });
  }
});

app.post('/api/complaints', authRequired, (req, res) => {
  try {
    const parsed = complaintSchema.parse(req.body);
    const user = (req as express.Request & { user: UserRecord }).user;

    if (parsed.orderId) {
      const order = db.prepare('SELECT * FROM orders WHERE id = ?').get(parsed.orderId) as any;
      if (!order) {
        res.status(404).json({ message: 'Заказ не найден.' });
        return;
      }
      if (order.customer_id !== user.id && user.role !== 'administrator') {
        res.status(403).json({ message: 'Вы можете подать жалобу только по своему заказу.' });
        return;
      }
    } else if (parsed.listingId) {
      const listing = db.prepare('SELECT id FROM listings WHERE id = ?').get(parsed.listingId);
      if (!listing) {
        res.status(404).json({ message: 'Объявление не найдено.' });
        return;
      }
    }

    const result = db.prepare(`
      INSERT INTO complaints (order_id, listing_id, user_id, category, description, photo_url, status, admin_note, created_at)
      VALUES (?, ?, ?, ?, ?, ?, 'new', '', datetime('now'))
    `).run(parsed.orderId || null, parsed.listingId || null, user.id, parsed.category, parsed.description, parsed.photoUrl || '');

    res.status(201).json({ id: result.lastInsertRowid, message: 'Жалоба отправлена в отдел модерации.' });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка отправки жалобы.';
    res.status(400).json({ message });
  }
});

app.get('/api/admin/overview', authRequired, requireRole(['administrator']), (_req, res) => {
  const restaurantPending = db.prepare("SELECT COUNT(*) as count FROM users WHERE role = 'restaurant' AND approved = 0").get() as { count: number };
  const orgPending = db.prepare("SELECT COUNT(*) as count FROM users WHERE role = 'organization' AND approved = 0").get() as { count: number };
  const complaints = db.prepare('SELECT COUNT(*) as count FROM complaints WHERE status = ?').get('new') as { count: number };
  const sales = db.prepare('SELECT COUNT(*) as count FROM orders WHERE status != ?').get('cancelled') as { count: number };
  const publishedListings = db.prepare('SELECT COUNT(*) as count FROM listings WHERE status = ?').get('published') as { count: number };
  const completedOrders = db.prepare("SELECT COUNT(*) as count, COALESCE(SUM(quantity), 0) as totalPortions FROM orders WHERE status = 'completed'").get() as { count: number; totalPortions: number };
  const donatedRequests = db.prepare("SELECT COUNT(*) as count, COALESCE(SUM(portions), 0) as totalPortions FROM donation_requests WHERE status = 'completed'").get() as { count: number; totalPortions: number };

  res.json({
    stats: {
      restaurantPending: restaurantPending.count,
      orgPending: orgPending.count,
      newComplaints: complaints.count,
      orders: sales.count,
      completedOrders: completedOrders.count,
      publishedListings: publishedListings.count,
      donatedPortions: donatedRequests.totalPortions,
      mealsRescued: completedOrders.totalPortions,
    },
    pendingUsers: db.prepare("SELECT * FROM users WHERE role IN ('restaurant', 'organization') AND approved = 0 ORDER BY created_at DESC").all(),
    complaints: db.prepare('SELECT c.*, l.title as listing_title FROM complaints c LEFT JOIN listings l ON c.listing_id = l.id ORDER BY c.created_at DESC LIMIT 20').all(),
    pendingListings: db.prepare('SELECT l.*, u.organization_name, u.name as restaurant_name FROM listings l JOIN users u ON l.restaurant_id = u.id WHERE l.status = ? ORDER BY l.created_at DESC').all('pending_review'),
  });
});

app.get('/api/admin/listings', authRequired, requireRole(['administrator']), (_req, res) => {
  const status = typeof (req.query as Record<string, unknown>).status === 'string' ? (req.query as Record<string, unknown>).status : '';
  const where = status ? "WHERE l.status = ?" : '';
  const params = status ? [status] : [];
  const rows = db.prepare(`SELECT l.*, u.organization_name, u.name as restaurant_name FROM listings l JOIN users u ON l.restaurant_id = u.id ${where} ORDER BY l.created_at DESC LIMIT 50`).all(...params) as any[];
  res.json({ items: rows });
});

app.post('/api/admin/listings/moderate', authRequired, requireRole(['administrator']), (req, res) => {
  try {
    const { listingId, decision, reason } = z.object({
      listingId: z.coerce.number().int().positive(),
      decision: z.enum(['approve', 'reject']),
      reason: z.string().optional().default(''),
    }).parse(req.body);
    const user = (req as express.Request & { user: UserRecord }).user;
    const listing = db.prepare('SELECT * FROM listings WHERE id = ?').get(listingId) as any;
    if (!listing) {
      res.status(404).json({ message: 'Объявление не найдено.' });
      return;
    }
    if (listing.status !== 'pending_review') {
      res.status(400).json({ message: 'Объявление уже обработано.' });
      return;
    }

    const newStatus = decision === 'approve' ? 'published' : 'suspended';
    db.prepare('UPDATE listings SET status = ?, rejection_reason = ?, updated_at = datetime("now") WHERE id = ?').run(newStatus, reason || null, listingId);

    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(
      user.id, `listing_${decision}`, JSON.stringify({ listingId, reason }),
    );

    res.json({ ok: true, status: newStatus });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка модерации.';
    res.status(400).json({ message });
  }
});

app.post('/api/admin/complaints/:id/status', authRequired, requireRole(['administrator']), (req, res) => {
  try {
    const { status, adminNote } = z.object({
      status: z.enum(['reviewing', 'resolved', 'dismissed']),
      adminNote: z.string().optional().default(''),
    }).parse(req.body);
    const user = (req as express.Request & { user: UserRecord }).user;
    const complaintId = Number(req.params.id);

    db.prepare('UPDATE complaints SET status = ?, admin_note = ? WHERE id = ?').run(status, adminNote || '', complaintId);
    db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run(
      user.id, 'complaint_resolved', JSON.stringify({ complaintId, status }),
    );

    res.json({ ok: true, status });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Ошибка обработки жалобы.';
    res.status(400).json({ message });
  }
});

app.post('/api/admin/verify-user', authRequired, requireRole(['administrator']), (req, res) => {
  const { userId, approved, note } = req.body as { userId?: number; approved?: boolean; note?: string };
  if (!userId) {
    res.status(400).json({ message: 'Нужно указать ID пользователя.' });
    return;
  }

  db.prepare('UPDATE users SET approved = ?, is_active = 1 WHERE id = ?').run(approved ? 1 : 0, userId);
  db.prepare('INSERT INTO audit_logs (actor_id, action, details) VALUES (?, ?, ?)').run((req as express.Request & { user: UserRecord }).user.id, 'verify_user', JSON.stringify({ userId, approved, note }));
  res.json({ ok: true });
});

app.get('/api/stats', (_req, res) => {
  const publishedListings = db.prepare("SELECT COUNT(*) as count FROM listings WHERE status = 'published'").get() as { count: number };
  const totalOrders = db.prepare("SELECT COUNT(*) as count, COALESCE(SUM(total_price), 0) as revenue FROM orders WHERE status != 'cancelled'").get() as { count: number; revenue: number };
  const completedOrders = db.prepare("SELECT COUNT(*) as count, COALESCE(SUM(quantity), 0) as portions FROM orders WHERE status = 'completed'").get() as { count: number; portions: number };
  const restaurants = db.prepare("SELECT COUNT(*) as count FROM users WHERE role = 'restaurant' AND approved = 1 AND is_active = 1").get() as { count: number };
  const orgs = db.prepare("SELECT COUNT(*) as count FROM users WHERE role = 'organization' AND approved = 1 AND is_active = 1").get() as { count: number };
  const donatedRequests = db.prepare("SELECT COALESCE(SUM(portions), 0) as total FROM donation_requests WHERE status = 'completed'").get() as { total: number };

  res.json({
    publishedListings: publishedListings.count,
    totalOrders: totalOrders.count,
    completedOrders: completedOrders.count,
    mealsRescued: completedOrders.portions,
    partners: restaurants.count + orgs.count,
    restaurants: restaurants.count,
    organizations: orgs.count,
    donatedPortions: Number(donatedRequests.total),
    revenue: Number(totalOrders.revenue),
  });
});

